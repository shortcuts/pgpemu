# -Os over the -Og default: smaller image (795760 vs 869232 bytes) for the 1500K factory slot.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Override some defaults so BT stack is enabled
# in this example

CONFIG_BT_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_MODE_BLE_ONLY=y

# Default (3072) overflows: our GATTS write callback (pgp_control_handle_command_write)
# runs NVS commits directly in BTC_TASK context for CONTROL_OP_SAVE_SETTINGS, which
# blew the stack (Guru Meditation: Core 0 panic'ed (Stack protection fault) in BTC_TASK).
CONFIG_BT_BTC_TASK_STACK_SIZE=6144

# Panic reboots (unattended device) and keeps a core dump in the coredump partition.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# crash_report.c needs the ELF summary API
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# A new OTA image must confirm itself (pgp_ota.c) or the bootloader returns to the old slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
